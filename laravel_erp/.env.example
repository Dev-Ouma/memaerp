APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database
# Allow OpsCenter restore to execute SQL against this database (local default is on).
MAINTENANCE_ALLOW_RESTORE=false

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=60
SESSION_ENCRYPT=true
SESSION_PATH=/
# Must stay null when using __Host- cookie names (production default).
SESSION_DOMAIN=null
# Local HTTP: leave secure false. Production HTTPS defaults Secure=true and
# SESSION_COOKIE=__Host-ERPSESSION when APP_ENV=production.
SESSION_SECURE_COOKIE=false
# SESSION_COOKIE=__Host-ERPSESSION
SESSION_IDLE_ADMIN=15
SESSION_IDLE_STAFF=20
SESSION_IDLE_DEFAULT=30
SESSION_ABSOLUTE_ADMIN=240
SESSION_ABSOLUTE_STAFF=480
SESSION_ABSOLUTE_DEFAULT=720
AUTH_PASSWORD_RESET_EXPIRE=15

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Test/demo only. Never enable in staging or production — it bypasses provider
# confirmation. Feature tests force true via phpunit.xml.
PAYMENT_SANDBOX_AUTO_CONFIRM=false

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
